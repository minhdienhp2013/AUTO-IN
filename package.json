{
  "name": "auto-in-minh-dien",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx --watch backend/server.ts",
    "start": "node dist/backend/server.js",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.ai2.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ai2.json",
    "test": "node --import tsx --test tests/unit/contracts/*.test.ts",
    "contracts:generate": "node --import tsx contracts/export.ts",
    "contracts:check": "node --import tsx contracts/export.ts --check",
    "check": "npm run contracts:check && npm run typecheck && npm test && npm run build && npm run test:core && npm run test:zalo && npm run test:composition",
    "test:core": "node scripts/run-core.mjs",
    "test:zalo": "node --experimental-strip-types --test tests/unit/zalo/*.test.mjs",
    "test:composition": "node --import tsx --test tests/integration/composition/*.test.ts tests/integration/composition/*.test.mjs",
    "db:migrate": "node --import tsx scripts/database.ts migrate",
    "db:bootstrap": "node --import tsx scripts/database.ts bootstrap",
    "core:controlled-test-grant": "node --import tsx scripts/controlled-test-grant.ts",
    "process:order": "node --import tsx scripts/process-order.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
